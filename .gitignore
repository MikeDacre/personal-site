# ── Local-only Claude documentation ──────────────────────────────────────
# CLAUDE/ is deliberately kept off GitHub (notes, roadmap, changelog).
# No loose docs/ or bin/ directories in the repo root: notes live in CLAUDE/
# (or .claude/). Never `git add -f CLAUDE/`.
CLAUDE/

# A convenience symlink to CLAUDE/CLAUDE.md for tools that expect it at root.
/CLAUDE.md

# ── Hugo ────────────────────────────────────────────────────────────────
public/
resources/_gen/
.hugo_build.lock
hugo_stats.json

# ── Secrets — NEVER commit. See CLAUDE.md § 3.1 ──────────────────────────
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
wrangler.toml.local
.wrangler/

# ── Cloudflare / tooling ─────────────────────────────────────────────────
.lighthouseci/
node_modules/
npm-debug.log*

# ── Python (scripts/cv_extract.py) ───────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ── Editors ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Scratch ──────────────────────────────────────────────────────────────
tmp/
*.log
cv_extract_debug/

# ── Releases — versioned zips for GitHub releases. Never committed. ─────
# Built with `git archive` only (see BUILDING.md / CLAUDE.md § 13.1).
releases/
